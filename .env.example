# --- MongoDB container (docker-compose.yaml) ---
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=changeme
MONGO_DATABASE=palantir_th

# --- App connection ---
MONGODB_URI=mongodb://root:changeme@localhost:27017/palantir_th?authSource=admin
MONGODB_DB=palantir_th

# --- Real-source ingestion (npm run db:seed) ---
# Use an identifiable contact URL/email for responsible access to public sources.
INGEST_USER_AGENT=Palantir-TH/0.1 (+https://github.com/your-org/palantir-th)
INGEST_REQUEST_TIMEOUT_MS=60000
INGEST_MAX_RESPONSE_BYTES=8388608
INGEST_MAX_API_RECORDS=2000

# UCDP Candidate uses its public CSV by default. A token enables the API;
# local CSV/JSON paths can be used for reproducible or licensed snapshots.
UCDP_ACCESS_TOKEN=
UCDP_GED_VERSION=26.1
UCDP_CANDIDATE_VERSION=26.0.7
UCDP_GED_DATASET_PATH=
UCDP_CANDIDATE_DATASET_PATH=

# ACLED OAuth bearer token.
ACLED_ACCESS_TOKEN=

# GTD requires an approved/licensed download; export it as CSV or JSON.
GTD_DATASET_PATH=
GTD_DATASET_VERSION=

# --- Satellite basemap (optional) ---
# Every map ships with the imagery layer OFF, so no third-party tile is
# requested until a user ticks it on.
#
# Preferred: a MapTiler key. Its "hybrid" map is imagery WITH road and place
# labels, which none of this app's own styles can draw (they declare no
# `glyphs`), so it is the option that actually helps someone find their street.
# Set NEXT_PUBLIC_MAPTILER_MAP=satellite for imagery without labels.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPTILER_MAP=

# With no key, the toggle falls back to Esri World Imagery, which serves
# keyless and CORS-enabled — convenient for a fresh clone, but ArcGIS Online's
# terms attach conditions to sustained or commercial use.
#
# Overrides both of the above: any tile source you are licensed for. Always
# change the attribution together with the URL — the credit shown to viewers is
# whatever is set here.
NEXT_PUBLIC_SATELLITE_TILE_URL=
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
NEXT_PUBLIC_SATELLITE_MAX_ZOOM=
