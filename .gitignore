# Google OAuth client credential, as downloaded from Google Cloud. A live
# secret; it has never been committed and this rule keeps it that way.
client_secret_*.apps.googleusercontent.com.json

# Agent skills installed from the internet (`npx skills add`). The content is
# reproducible from skills-lock.json, which records each skill's source repo and
# a content hash — tracking ~47K lines of vendored markdown instead would bury
# every real diff. Skills written for this project are the exception and must be
# added below by hand.
.agents/skills/*
!.agents/skills/agent-commit/
!.agents/skills/citizen-geo-report/
.env.production

# Vercel CLI project link (`vercel link`). Contains the project/org ids and
# is machine-local, like .env.local.
.vercel
