# ml-server settings.
#
# This file is OPTIONAL. With none of it set, the service falls back to the
# repo's own ./.env, so a working app checkout already has a working batch job.
#
# Resolution order, lowest precedence first:
#   1. <repo>/.env          -- what the Next.js app and the notebook use
#   2. ml-server/.env       -- this file, to point the model somewhere else
#   3. shell environment    -- what a deployment sets
#
# Whichever wins, the resolved (password-masked) URI is printed at startup by
# both run_batch.py and run_server.py. Check that line before trusting a number.

# --- Database ---
# Only needs read access to `event_candidates`; it writes to the flow_* collections.
MONGODB_URI=
MONGODB_DB=palantir_th

# --- Road network ---
# Defaults to <repo>/public/data/south-roads.graph.json, built by `npm run gis:roads`.
ROAD_GRAPH_PATH=
ROAD_META_PATH=

# --- API ---
ML_API_HOST=127.0.0.1
ML_API_PORT=8000

# Browser origins allowed to call the API directly. Not needed if the Next.js
# app proxies through its own route handler, which is the recommended shape --
# then the only caller is the Next.js server and no origin is a browser.
ML_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
